# Copy to .env to override. Every value below is optional.

# Host ports (always bound to 127.0.0.1)
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8088

# DANFSe engine: maximum accepted XML size in bytes (engine default 5 MiB, hard cap 32 MiB)
XML_MAX_SIZE_BYTES=5242880

# JVM flags for both Java engines.
# -XX:-UseBASE64Intrinsics is the mitigation mentioned in the upstream CHANGELOG 1.0.1.
JAVA_TOOL_OPTIONS=-XX:-UseBASE64Intrinsics -XX:MaxRAMPercentage=60
