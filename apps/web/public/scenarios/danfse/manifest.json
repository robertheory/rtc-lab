{
  "engine": "danfse",
  "basePath": "/api/danfse",
  "scenarios": [
    {
      "id": "nfse-simples",
      "name": "NFS-e simples",
      "description": "NFS-e sem o grupo IBS/CBS.",
      "category": "basico",
      "method": "POST",
      "endpoint": "/api/danfse",
      "contentType": "application/xml",
      "payload": "nfse-simples.xml",
      "query": {
        "stc": "0",
        "canhoto": "true"
      },
      "explanation": "XML de NFS-e nacional sem IBS/CBS. Gera o DANFSe normal com canhoto.",
      "expected": {
        "status": 200,
        "contentType": "application/pdf",
        "summary": "PDF do DANFSe."
      },
      "source": {
        "repository": "calculadora-rtc-regime-regular",
        "tag": "1.7.2",
        "path": "src/test/resources/xml/nfse/valido/nota/nfse_valido_sem_IBSCBS.xml",
        "note": "XML de teste do regime regular, aceito pelo XSD (validate) e pelo gerador de DANFSe."
      }
    },
